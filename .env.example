# Copy to .env, or supply these in the process environment. Never put keys in the frontend.
ARK_API_KEY=
TAVILY_API_KEY=
GOOGLE_MAPS_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TALKER_MODEL=doubao-seed-2-0-mini-260428
THINKER_MODEL=doubao-seed-2-1-pro-260915
VEHICLE_CONTROL_MODEL=doubao-seed-2-1-pro-260915
THINKER_CONCURRENCY=2
THINKER_MAX_STEPS=20
THINKER_TIMEOUT_SECONDS=300
THINKER_CLARIFICATION_TIMEOUT_SECONDS=1800
MODEL_TIMEOUT_SECONDS=45
TOOL_TIMEOUT_SECONDS=12
DATABASE_PATH=data/super_xd.sqlite3
HOST=127.0.0.1
PORT=8000

# Optional Volcengine Speech TTS (separate from ARK_API_KEY).
# Fixed Xiaohe 2.0 speaker: zh_female_xiaohe_uranus_bigtts; resource: seed-tts-2.0.
# New Speech console: set this API Key.
VOLCENGINE_SPEECH_API_KEY=
# Old Speech console alternative: set BOTH App ID and Access Token.
VOLCENGINE_SPEECH_APP_ID=
VOLCENGINE_SPEECH_ACCESS_TOKEN=
VOLCENGINE_SPEECH_TTS_TIMEOUT_SECONDS=45
# Optional read-only xcconfig reference when environment Speech credentials are absent.
# File must contain literal TTS_API_KEY and TTS_RESOURCE_ID = seed-tts-2.0.
# VOLCENGINE_SPEECH_CONFIG_FILE=/absolute/path/to/Secrets.xcconfig

# Optional independent Volcengine streaming ASR credentials. TTS keys are not assumed to grant ASR access.
VOLCENGINE_ASR_API_KEY=
# Old Speech console alternative: configure BOTH values.
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_TOKEN=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLCENGINE_ASR_TIMEOUT_SECONDS=15
# Optional read-only .env reference containing VOLC_ASR_API_KEY and VOLC_ASR_RESOURCE_ID.
# Endpoint/language from an older benchmark are not inherited.
# VOLCENGINE_ASR_CONFIG_FILE=/absolute/path/to/asr-project/.env
