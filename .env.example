# Standalone NLP service: uvicorn backend.nlp_app:configured_app --factory --port 8001
# Gateway owns authentication, conversation/task storage and device execution.
NLP_GATEWAY_URL=
NLP_GATEWAY_TOKEN=
NLP_GATEWAY_TIMEOUT_SECONDS=10
NLP_MAX_BODY_BYTES=8388608
NLP_MAX_INFLIGHT=32
NLP_REQUEST_TIMEOUT_SECONDS=120

# Copy to .env, or supply these in the process environment. Never put keys in the frontend.
ARK_API_KEY=
TAVILY_API_KEY=
GOOGLE_MAPS_API_KEY=
# Car-manual text embeddings use a separately authorized Ark key.
ARK_EMBEDDING_API_KEY=
ARK_EMBEDDING_MODEL=doubao-embedding-vision-251215
ARK_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
MANUAL_INDEX_PATH=data/manuals/denza_d9.sqlite3
# Optional absolute pdftoppm path for original PDF page previews; otherwise use PATH.
# MANUAL_PDFTOPPM_BIN=/opt/homebrew/bin/pdftoppm
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TALKER_MODEL=doubao-seed-2-0-mini-260428
THINKER_MODEL=doubao-seed-2-1-pro-260915
VEHICLE_CONTROL_MODEL=doubao-seed-2-1-pro-260915
THINKER_CONCURRENCY=2
THINKER_MAX_STEPS=20
# Hard maximum is 60s, including queue time; waiting for clarification pauses it.
# Progress is announced once at 30s; the last 15s are reserved for delivery.
THINKER_TIMEOUT_SECONDS=60
THINKER_CLARIFICATION_TIMEOUT_SECONDS=1800
MODEL_TIMEOUT_SECONDS=45
TOOL_TIMEOUT_SECONDS=12
DATABASE_PATH=data/super_xd.sqlite3
DEFAULT_SPEAKER_SEAT=driver
# User-provided location; empty means the assistant must ask when a place is needed.
DEFAULT_LOCATION=
DEFAULT_LOCATION_COUNTRY=
DEFAULT_TIMEZONE=UTC
# Example: Paris / France / Europe/Paris. No GPS coordinates are inferred.
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5173
# Optional isolated deployment origins; scripts/start.sh sets defaults from ports.
# FRONTEND_ORIGIN=http://127.0.0.1:5174
# API_ORIGIN=http://127.0.0.1:8001

# Runtime adapters/roles: config/services.toml. Restart API AND worker after edits.
# SERVICES_CONFIG_PATH=/absolute/path/to/services.toml
# ASR_PROFILE=vllm
ASR_BASE_URL=
ASR_MODEL=
ASR_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
# LLM role models/profile/reasoning/token budgets are in services.toml.
# WEB_SEARCH_PROFILE=gateway
WEB_SEARCH_GATEWAY_URL=
WEB_SEARCH_GATEWAY_KEY=
WEB_CONTENT_GATEWAY_URL=
WEB_CONTENT_GATEWAY_KEY=
PLACES_GATEWAY_URL=
PLACES_GATEWAY_KEY=
WEATHER_GATEWAY_URL=
WEATHER_GATEWAY_KEY=
ROUTES_GATEWAY_URL=
ROUTES_GATEWAY_KEY=
# MANUAL_PROFILE=gateway; local_rag remains default.
MANUAL_GATEWAY_URL=
MANUAL_GATEWAY_KEY=
# EMBEDDING_PROFILE=compatible only applies to services that need vectors.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Content kinds bind independently; no automatic CP fallback.
# MEDIA_MUSIC_PROFILE=tencent
# MEDIA_VIDEO_PROFILE=video_gateway
# MEDIA_RADIO_PROFILE=radio_gateway
TENCENT_MUSIC_GATEWAY_URL=
TENCENT_MUSIC_GATEWAY_KEY=
VIDEO_CP_URL=
VIDEO_CP_KEY=
RADIO_CP_URL=
RADIO_CP_KEY=
# Opt-in development catalog; does not claim external CP is connected.
# MEDIA_PROFILE=local
# MEDIA_ROOT=/absolute/path/to/data/media

# Optional Volcengine Speech TTS (separate from ARK_API_KEY).
# Fixed Xiaohe 2.0 speaker: zh_female_xiaohe_uranus_bigtts; resource: seed-tts-2.0.
# New Speech console: set this API Key.
VOLCENGINE_SPEECH_API_KEY=
# Old Speech console alternative: set BOTH App ID and Access Token.
VOLCENGINE_SPEECH_APP_ID=
VOLCENGINE_SPEECH_ACCESS_TOKEN=
VOLCENGINE_SPEECH_TTS_TIMEOUT_SECONDS=45
# Optional read-only xcconfig reference when environment Speech credentials are absent.
# File must contain literal TTS_API_KEY and TTS_RESOURCE_ID = seed-tts-2.0.
# VOLCENGINE_SPEECH_CONFIG_FILE=/absolute/path/to/Secrets.xcconfig

# Optional independent Volcengine streaming ASR credentials. TTS keys are not assumed to grant ASR access.
VOLCENGINE_ASR_API_KEY=
# Old Speech console alternative: configure BOTH values.
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_TOKEN=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLCENGINE_ASR_TIMEOUT_SECONDS=15
# Optional read-only .env reference containing VOLC_ASR_API_KEY and VOLC_ASR_RESOURCE_ID.
# Endpoint/language from an older benchmark are not inherited.
# VOLCENGINE_ASR_CONFIG_FILE=/absolute/path/to/asr-project/.env
