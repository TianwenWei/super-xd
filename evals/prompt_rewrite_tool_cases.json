    "vehicle": {"climate": {"power": false}},
    "expected_calls": [{"name": "set_temperature", "arguments": {"zone": "driver", "temperature": 24}}],
    "expected_behavior": "只调用设温度；该工具会自动开启空调，不额外调用set_climate_power。"
  },
  {
    "id": "temperature_relative_enables_power",
