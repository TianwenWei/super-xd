[
  {"id": "hold_other_zone", "tags": ["hold"], "personas": ["professional", "warm", "playful"],
   "turns": [{"input": "主驾温度调到23度，音量35，副驾温度别动",
              "expect": {"commands": [{"name": "set_temperature", "arguments": {"zone": "driver", "temperature": 23}},
                                      {"name": "set_volume", "arguments": {"volume": 35}}],
                         "forbid_commands": [{"name": "set_temperature", "arguments": {"zone": "front_passenger"}},
                                             {"name": "set_temperature", "arguments": {"zone": "all"}}],
                         "unchanged": ["climate.temperatures.front_passenger"]}}]},
  {"id": "hold_ambient_not_closed", "tags": ["hold"],
   "turns": [{"input": "先别开氛围灯，把车内灯打开",
              "expect": {"commands": [{"name": "set_interior_light", "arguments": {"enabled": true}}],
                         "forbid_commands": [{"name": "set_ambient_light"}],
                         "unchanged": ["lights.ambient"]}}]},
  {"id": "hold_only_no_action", "tags": ["hold"],
   "turns": [{"input": "氛围灯保持现状就行",
              "expect": {"no_commands": true, "unchanged": ["lights.ambient"]}}],
   "vehicle": {"lights.ambient": true}},
  {"id": "correction_last_wins", "tags": ["hold", "correction"],
   "turns": [{"input": "不是关闭氛围灯，是打开氛围灯",
              "expect": {"commands": [{"name": "set_ambient_light", "arguments": {"enabled": true}}],
                         "forbid_commands": [{"name": "set_ambient_light", "arguments": {"enabled": false}}],
                         "state": {"lights.ambient": true}}}]},
  {"id": "window_hold_with_other_window", "tags": ["hold"],
   "turns": [{"input": "把副驾车窗打开一半，主驾车窗别动",
              "expect": {"commands": [{"name": "set_window_position", "arguments": {"window": "front_passenger", "position": 50}}],
                         "forbid_commands": [{"name": "set_window_position", "arguments": {"window": "driver"}},
                                             {"name": "close_all_windows"}],
                         "unchanged": ["windows.positions.driver"]}}],
   "vehicle": {"windows.positions.driver": 20}},
  {"id": "state_question_no_write", "tags": ["hold", "question"],
   "turns": [{"input": "方向盘加热现在开着吗？",
              "expect": {"forbid_commands": [{"name": "set_steering_heating"}], "unchanged": ["seats.steering_heating"]}}]}
]
