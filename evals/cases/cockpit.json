[
  {
    "id": "cockpit_pause",
    "tags": [
      "cockpit"
    ],
    "personas": [
      "professional",
      "warm",
      "playful"
    ],
    "cockpit": {
      "items": [
        {
          "content_id": "fixture:rain",
          "kind": "music",
          "title": "清晨细雨",
          "source_url": "https://media.example/fixture-rain.mp3"
        }
      ],
      "state": {
        "media.content_id": "fixture:rain",
        "media.kind": "music",
        "media.title": "清晨细雨",
        "media.status": "playing",
        "media.desired_status": "playing"
      }
    },
    "turns": [
      {
        "input": "先把正在放的声音暂停吧",
        "expect": {
          "talker_calls": [
            {
              "name": "control_media",
              "arguments": {
                "action": "pause"
              }
            }
          ],
          "forbid_talker_calls": [
            "delegate_vehicle_control",
            "delegate_task"
          ],
          "no_commands": true,
          "cockpit_commands": [
            {
              "domain": "media",
              "action": "pause"
            }
          ],
          "cockpit_commands_exact": true,
          "cockpit_state": {
            "media.status": "paused"
          }
        }
      }
    ]
  },
